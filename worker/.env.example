# ============================================================
# المُرسِل الداخلي SMS — متغيرات اللابتوب (انسخيه إلى .env)
# يُنسخ هذا المجلد + app/sms_service.py إلى اللابتوب داخل سوريا
# ============================================================

# عنوان الخادم على Cloudflare (بدون شرطة نهاية) — HTTPS فقط
API_BASE_URL=https://your-api-domain.com

# نفس قيمة WORKER_TOKEN المضبوطة على الخادم (لا تُنشر أبداً في أي مكان عام)
WORKER_TOKEN=

# بيانات حساب سيرياتيل BMS — تُضبط هنا على اللابتوب فقط، لا حاجة لها على الخادم
SYRIATEL_USERNAME=
SYRIATEL_PASSWORD=
SYRIATEL_SENDER=
SYRIATEL_TEMPLATE_CODE=

# اختياري — إيقاعات افتراضية مناسبة
SMS_POLL_INTERVAL=1
SMS_HEARTBEAT_INTERVAL=30
SMS_BATCH_SIZE=3