# ============================================================
# Wijhatak Al-Akademia API — متغيرات البيئة المطلوبة
# انسخي هذا الملف إلى .env ثم عبي القيم الصحيحة
# ============================================================

# ---------- مطلوب دائماً ----------
# عنوان قاعدة البيانات PostgreSQL بصيغة SQLAlchemy
# مثال محلي:  postgresql+psycopg2://postgres:1234@localhost:5432/wijhatak
# مثال Render: postgresql://USER:PASSWORD@HOST:PORT/wijhatak?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/wijhatak

# سر توقيع توكنات JWT — قيمة عشوائية طويلة (openssl rand -hex 32)
# ⚠️ لا تستخدمي أبداً القيمة الافتراضية التالية في الإنتاج
JWT_SECRET_KEY=your-super-secret-key-change-me

# ---------- اختياري ----------
# بيئة التشغيل: development (افتراضي) | production
# - production: يخفي /docs و/redoc ويفعّل CORS من ALLOWED_ORIGINS
# - development: يفتح /docs و يسمح بأي origin
APP_ENV=development

# متاح فقط في production — دومينات الفرونت المسموح لها، مفصولة بفواصل
ALLOWED_ORIGINS=

# خوارزمية JWT (افتراضي HS256) ومدة صلاحية التوكن بالدقائق (افتراضي 480 = 8 ساعات)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- SMS (سيرياتيل) — المطلوبة فقط لتفعيل إرسال الرموز ----------
SYRIATEL_USERNAME=
SYRIATEL_PASSWORD=
SYRIATEL_SENDER=
SYRIATEL_TEMPLATE_CODE=

# ---------- كلمات سر حسابات الـ seed الأولية ----------
# خارج بيئة development: إلزامية، وإلا يرفض السكريبت العمل
SEED_PASSWORD_TAHER_SUPER=
SEED_PASSWORD_SEDRA_ADMIN=
SEED_PASSWORD_RIMA_STAFF=
SEED_PASSWORD_HADI_GATE=

# ---------- الوكيل (اختياري) ----------
# إذا كان السيرفر خلف وكيل موثوق (nginx/cloudflare tunnel) اضبطي =1
# ليقرأ عنوان IP الحقيقي من X-Forwarded-For بدل عنوان الوكيل
TRUST_PROXY_HEADERS=0